# ── Fish secrets (never commit) ────────────────────────────────────────────────
**/conf.d/.env.personal
**/conf.d/.env.work
**/fish_variables

# ── SSH: allowlist — only ssh/.ssh/config is ever tracked ─────────────────────────
# Default-deny rather than listing key names: a key with an unexpected name (work.pem,
# id_rsa_old, a stray known_hosts.old) is ignored by default instead of by luck.
ssh/.ssh/*
!ssh/.ssh/config

# ── Git per-machine identity ───────────────────────────────────────────────────
# Any config.* variant (config.local, config.work, config.personal, ...) holds an identity;
# default-deny it, and allow back only the tracked template.
**/git/config.*
!**/git/config.local.example

# ── opencode runtime (managed by opencode itself) ──────────────────────────────
**/opencode/node_modules/
**/opencode/plugins/
**/opencode/skills/
**/opencode/package.json
**/opencode/package-lock.json
**/opencode/tui.json
**/opencode/cli.json
**/opencode/opencode.json
**/opencode/work.jsonc
# V1-era work-rules file; kept so a leftover copy can't be committed by accident
**/opencode/AGENTS.*.local.md

# ── macOS ──────────────────────────────────────────────────────────────────────
**/.DS_Store

# ── General (safety net) ───────────────────────────────────────────────────────
node_modules/
*.log

**/vscode/settings.local.json

# ── Work MCP servers (package scope / paths name an employer) ──────────────────
# Copy vscode/mcp.json.example → vscode/mcp.json and fill in locally.
**/vscode/mcp.json