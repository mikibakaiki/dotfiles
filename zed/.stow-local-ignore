# Stow ignore patterns are anchored Perl regexes matched against each basename — NOT
# gitignore syntax. The previous `prompts/` and `themes/` never matched anything, so stow
# was linking Zed's live prompt database into the repo. Matching the directory's basename
# excludes everything under it.
#
# prompts/ holds Zed's LMDB prompt library: a live database Zed writes to, not config.
prompts
themes
\.DS_Store
