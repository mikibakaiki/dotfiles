# Secret environment variables available to all CLI tools.
# Keep this file local to your machine.

# Valid
# KEY=value
# KEY="value with spaces"
# export KEY=value

# Will be silently skipped (safe)
# # this is a comment
# KEY=                    ← empty value, skipped
# KEY=value=with=equals   ← only first = is used, fine



JIRA_PAT=TOKEN
CONFLUENCE_PAT=TOKEN
BITBUCKET_TOKEN=TOKEN
JENKINS_TOKEN=TOKEN
ARTIFACTORY_TOKEN=TOKEN
# Public environment variables available to all CLI tools.
JIRA_BASE_URL=URL
CONFLUENCE_BASE_URL=URL
JENKINS_BASE_URL=URL
BITBUCKET_BASE_URL=URL
ARTIFACTORY_BASE_URL=URL
