{
  "$schema": "https://opencode.ai/config.json",

  // Native OpenCode V2 format. V2 still reads V1 keys, but nested entries (agents, providers,
  // models) must stay entirely in one format — don't mix V1 fields back into these.

  // No `instructions` here: V2 accepts the field but does not currently load its entries. The
  // terse-chat style and the /handoff nudge that style.md used to carry now live in AGENTS.md
  // next to this file, which V2 always loads as the global instructions.

  // Model — via GitHub Copilot subscription (no separate Anthropic billing)
  "model": "github-copilot/claude-sonnet-5",

  "agents": {
    // Replaces V1 `small_model`, which V2 maps to `title`. `summary` (another hidden
    // maintenance agent) is pinned too so it stays off Copilot as well.
    // llama-server answers with whichever model is loaded, so this works with either one
    // running. Caveat: if llama-server is down, titles and summaries fail even when the main
    // model is Copilot.
    "title": {
      "model": "llamacpp/qwen3.8-27b-local"
    },
    "summary": {
      "model": "llamacpp/qwen3.8-27b-local"
    },
    // Built-in read-only agent that tech-lead and implementation-specialist hand investigation
    // to. Model (chosen 2026-09): GPT-6 Luna at medium effort. Reading and summarising code is
    // where a lightweight model is enough, and every file it reads stays out of the expensive
    // tech-lead context. At $0.10 per 1M input tokens it is 1/40th of Opus 5.5.
    // When to change: if its summaries mislead tech-lead (wrong file, missed caller, invented
    // behaviour), switch to github-copilot/gpt-6-sol#low.
    //
    // It also ships its own policy that allows web search. The docs don't say whether that lands
    // before or after these rules, so deny it here explicitly as well.
    "explore": {
      "model": "github-copilot/gpt-6-luna#medium",
      "permissions": [{ "action": "websearch", "resource": "*", "effect": "deny" }]
    }
  },

  "providers": {
    "llamacpp": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "qwen3.8-27b-local": {
          "name": "Qwen3.8 27B (local)",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          // context must match llama-server's -c flag; 16384 output leaves room for thinking
          "limit": { "context": 65536, "output": 16384 }
        },
        // Lower context than the 27B on purpose: this quant is ~22.3GB against a 24576MB
        // wired limit, so a 64K KV cache does not fit. llm-fast starts it at 32768 with a
        // q8_0 KV cache; these two numbers must stay in step or requests fail with HTTP 400.
        "qwen3.6-35b-a3b-local": {
          "name": "Qwen3.6 35B-A3B (local, fast)",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          "limit": { "context": 32768, "output": 16384 }
        }
      }
    }
  },

  // Privacy wall for every session outside the vault (e.g. Copilot agents in work repos).
  // Ordered list; the last matching rule wins, so the broad rule comes first. The vault is
  // off-limits, except raw/ so /handoff can write there — you get a prompt; approve "once",
  // never "always". That prompt is also the signal that something wrote a handoff you didn't
  // expect; /handoff echoing its frontmatter is the other.
  // The zk-* functions run OpenCode from inside the vault, so this never gets in their way.
  // V2 expands the leading ~ for external_directory resources.
  //
  // Web search is off for every agent: V2 ships a built-in websearch tool that is allowed by
  // default, and a query can carry whatever the session has read (including vault content).
  // Agents that need it can allow it in their own permissions, which apply after these.
  "permissions": [
    { "action": "websearch", "resource": "*", "effect": "deny" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "~/code/Zettelkasten/**", "effect": "deny" },
    { "action": "external_directory", "resource": "~/code/Zettelkasten/raw/**", "effect": "ask" }
  ],

  "plugins": [
    // Pinned: bump deliberately and record it in a handoff.
    // Holding at 3.1.15 because 3.2.0 was released 2026-09-20 and hadn't been soaked yet.
    // Re-evaluate that on any bump — don't read this as still-current advice.
    // KNOWN FAILURE on V2: the plugin API is one of V2's documented breaking changes, and
    // every published DCP release (3.1.15 through 3.2.8-beta0) targets the V1 API
    // (@opencode-ai/plugin), not V2's @opencode/plugin. Expect it not to load. Kept on purpose
    // as a known failure: bump the pin once a V2 build ships; see docs/setup-zettelkasten.md.
    "@tarquinen/opencode-dcp@3.1.15"
  ]

  // NOTE: work-specific MCP servers (Jira/Confluence/Jenkins) used to live in this file,
  // hardcoded to a work machine's local paths. Removed — they don't belong in tracked
  // dotfiles. Re-add them on the work machine via a local, gitignored override instead.
  // See docs/setup-work-machine.md for the exact mechanism,
  // following the same pattern as fish/.config/fish/conf.d/.env.work (untracked, machine-local).
}
