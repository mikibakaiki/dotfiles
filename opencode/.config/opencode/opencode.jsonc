{
  "$schema": "https://opencode.ai/config.json",

  // Terse chat replies; anything written to disk stays in normal English, plus the /handoff
  // nudge. Replaces the opencode-caveman plugin.
  "instructions": ["style.md"],

  // Model — via GitHub Copilot subscription (no separate Anthropic billing)
  "model": "github-copilot/claude-sonnet-5",

  // Keeps background tasks (titles, summaries) off Copilot.
  // llama-server answers with whichever model is loaded, so this works with either one running.
  // Caveat: if llama-server is down, title generation fails even when the main model is Copilot.
  "small_model": "llamacpp/qwen3.8-27b-local",

  "provider": {
    "llamacpp": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "qwen3.8-27b-local": {
          "name": "Qwen3.8 27B (local)",
          "tool_call": true,
          // context must match llama-server's -c flag; 16384 output leaves room for thinking
          "limit": { "context": 65536, "output": 16384 }
        },
        // Lower context than the 27B on purpose: this quant is ~22.3GB against a 24576MB
        // wired limit, so a 64K KV cache does not fit. llm-fast starts it at 32768 with a
        // q8_0 KV cache; these two numbers must stay in step or requests fail with HTTP 400.
        "qwen3.6-35b-a3b-local": {
          "name": "Qwen3.6 35B-A3B (local, fast)",
          "tool_call": true,
          "limit": { "context": 32768, "output": 16384 }
        }
      }
    }
  },

  // Privacy wall for every session outside the vault (e.g. Copilot agents in work repos).
  // Last matching rule wins. The vault is off-limits, except raw/ so /handoff can write there —
  // you get a prompt; approve "once", never "always". That prompt is also the signal that
  // something wrote a handoff you didn't expect; /handoff echoing its frontmatter is the other.
  // The zk-* functions run OpenCode from inside the vault, so this never gets in their way.
  "permission": {
    "external_directory": {
      "*": "ask",
      "~/code/Zettelkasten/**": "deny",
      "~/code/Zettelkasten/raw/**": "ask"
    }
  },

  "plugin": [
    // Pinned: bump deliberately and record it in a handoff.
    // Holding at 3.1.15 because 3.2.0 was released 2026-09-20 and hadn't been soaked yet.
    // Re-evaluate that on any bump — don't read this as still-current advice.
    "@tarquinen/opencode-dcp@3.1.15"
  ]

  // NOTE: work-specific MCP servers (Jira/Confluence/Jenkins) used to live in this file,
  // hardcoded to a work machine's local paths. Removed — they don't belong in tracked
  // dotfiles. Re-add them on the work machine via a local, gitignored override instead.
  // See the "Work MCP servers" section of the macOS setup guide for the exact mechanism,
  // following the same pattern as fish/.config/fish/conf.d/.env.work (untracked, machine-local).
}
