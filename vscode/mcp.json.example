// Copy to vscode/mcp.json and fill in your own org scope and paths.
// vscode/mcp.json is gitignored: the package scope and server paths name an employer.
{
  "servers": {
    "jira-mcp": {
      "type": "stdio",
      "command": "node",
      "args": [
        "~/.local/share/mcp/jira-mcp/node_modules/@your-org/jira-mcp/build/server.js"
      ],
      "envFile": "~/.local/share/mcp/jira-mcp/.env"
    },
    "confluence-mcp": {
      "type": "stdio",
      "command": "node",
      "args": [
        "~/.local/share/mcp/confluence-mcp/node_modules/@your-org/confluence-mcp/build/server.js"
      ],
      "envFile": "~/.local/share/mcp/confluence-mcp/.env"
    }
  }
}
